LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.2
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Optional. Semantic Scholar throttles anonymous traffic hard; without a key
# that source will usually fail and the search falls back to the others.
SEMANTIC_SCHOLAR_API_KEY=
# Optional. OpenAlex needs no key. A contact address moves requests into its
# faster polite pool.
OPENALEX_MAILTO=
QDRANT_URL=http://localhost:6333
REPORT_DB_PATH=data/researchpilot.db
CORS_ORIGINS=http://localhost:3000
